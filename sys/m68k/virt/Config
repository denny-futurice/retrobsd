#
# QEMU "virt" board, Motorola 68030 with 68881 FPU
# ================================================
# qemu-system-m68k -M virt -cpu m68030 (see docs/porting/).
#
# To build the kernel, use:
#   cd sys/m68k/virt
#   ../../../tools/kconfig/kconfig Config
#   make clean
#   make
#
architecture    "m68k"
cpu             "M68030"                    # Processor variant
board           "QEMU_VIRT"                 # Board type
ldscript        "virt/kernel.ld"            # Linker script

# Root filesystem at /dev/vd0a, swap at /dev/vd0b: the first two MBR
# partitions of the first virtio disk (D36)
config          unix    root on vd0a
                        swap on vd0b

# Goldfish TTY, the QEMU serial console (-serial stdio)
device          gftty0

# virtio block disks, numbered in slot order (-device virtio-blk-device)
device          vd0
device          vd1

# QEMU's 68030 has no fsave/frestore: save only the FPU registers (D28)
options         "FPU_NO_FSAVE"

# Console options
options         "CONS_MAJOR=UART_MAJOR"     # Goldfish TTY
options         "CONS_MINOR=0"              # /dev/tty0
