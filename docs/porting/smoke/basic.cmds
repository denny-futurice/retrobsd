# BASIC INP/OUT through /dev/mem (D48).  Typed at the root prompt in
# multi-user mode (securelevel 1), then in single-user mode (securelevel 0).
echo mem `ls -l /dev/mem | awk '{ print $1, $3 }'` kmem `ls -l /dev/kmem | awk '{ print $1, $3 }'`
printf '10 print inp(524288)\n20 print inp(524290) - inp(524288)\n30 exit\n' >/tmp/in.bas
printf '10 out 655360, 305419896\n20 print inp(655360)\n30 print inp(655362) - inp(655360)\n40 exit\n' >/tmp/out.bas
printf '10 print inp(16777216)\n20 exit\n' >/tmp/bad.bas
chmod 644 /tmp/in.bas
# INP reads basic's own first text word at USER_DATA_START; an unaligned
# address reads the same word, so the difference is 0.
basic /tmp/in.bas </dev/null 2>&1 | sed -n '1,2s/^/in: /p'
# OUT needs /dev/mem read-write, refused above securelevel 0.
basic /tmp/out.bas </dev/null 2>&1 | sed -n '1,2s/^/out1: /p'
basic /tmp/bad.bas </dev/null 2>&1 | sed -n '1,2s/^/bad: /p'
su daemon -c 'basic /tmp/in.bas </dev/null 2>&1' | sed -n '1,2s/^/user: /p'
@send kill -TERM 1
@wait security level changed from 1 to 0
basic /tmp/out.bas </dev/null 2>&1 | sed -n '1,2s/^/out0: /p'
rm -f /tmp/in.bas /tmp/out.bas /tmp/bad.bas
